# Postgres connection string
DATABASE_URL=postgres://meridian:meridian@localhost:5432/meridian

# Auth.js secret: generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=

# Public URL of the site. Required when self-hosting (not needed on Vercel).
AUTH_URL=http://localhost:3000

# osu! OAuth application (https://osu.ppy.sh/home/account/edit#oauth)
# Callback URL to register: http://localhost:3000/api/auth/callback/osu
AUTH_OSU_ID=
AUTH_OSU_SECRET=

# Comma-separated osu! user IDs that become admins on sign-in
ADMIN_OSU_IDS=

# Platform fee in basis points (500 = 5%)
PLATFORM_FEE_BPS=500

# Development only: allows /api/dev-login?user=<username> to sign in as any user without osu!.
# Ignored unless running `npm run dev`. Never set this on a real server.
DEV_LOGIN=false
